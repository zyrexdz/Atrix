# Discord Bot Token from the Discord Developer Portal
# https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# ─── LLM Provider ──────────────────────────────────────────────────────────
# Pick one: deepseek (default), openai, anthropic, gemini, groq, openrouter,
# together, mistral, custom. Each provider has its own key env var below.
LLM_PROVIDER=deepseek

# DeepSeek — default. Cheap, persona lands well. https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI — gpt-4o-mini, gpt-5-mini, etc. https://platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic — Claude Haiku 4.5 is great for persona chat. https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Google Gemini — free tier includes gemini-3.8-flash and 3.5-flash-lite.
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Groq — fast free inference for Llama, Mixtral. https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter — routes to many models, some free. https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Together AI — free credits on signup. https://api.together.xyz
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# Mistral — free tier for small models. https://console.mistral.ai
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Custom OpenAI-compatible endpoint (LM Studio, vllm, llama.cpp, etc.)
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=

# ─── Voice transcription (Whisper) ─────────────────────────────────────────
# Optional. Independent of LLM_PROVIDER. Set OPENAI_API_KEY above to enable.
OPENAI_TRANSCRIBE_MODEL=whisper-1

# ─── Misc ──────────────────────────────────────────────────────────────────
# Your Discord user ID — optional. If set, the bot only responds to you.
# Right-click your Discord profile → "Copy User ID" (Developer Mode must be on).
ALLOWED_USER_ID=

# Timezone used when a user hasn't told the bot their own.
# "auto" picks your machine's local zone.
TIMEZONE=auto